# Salin menjadi .env.prod lalu isi. File .env.prod TIDAK boleh masuk git.
#
# Buat SECRET_KEY dan POSTGRES_PASSWORD acak dengan:
#   openssl rand -hex 32
# (hanya huruf dan angka, sehingga aman dipakai di DATABASE_URL)

# --- Django ---
DEBUG=False
SECRET_KEY=GANTI-DENGAN-HASIL-openssl-rand-hex-32
# Pertahankan 127.0.0.1 (dipakai pemeriksaan kesehatan container). Tambahkan domain Anda.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# True bila situs dilayani lewat HTTPS (domain). False untuk uji lokal lewat HTTP.
COOKIE_SECURE=False

# --- Caddy ---
# ":80" = HTTP saja. Untuk HTTPS otomatis isi nama domain, mis. sekolah.contoh.id
SITE_ADDRESS=:80
# Port di komputer ini. Uji lokal di WSL: 8080. Server sungguhan: 80 dan 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Database ---
POSTGRES_DB=sekolah_model
POSTGRES_USER=sekolah
POSTGRES_PASSWORD=GANTI-DENGAN-HASIL-openssl-rand-hex-32
# Host-nya "db" (nama service compose). Password harus sama dengan di atas.
DATABASE_URL=postgres://sekolah:GANTI-PASSWORD-YANG-SAMA@db:5432/sekolah_model
